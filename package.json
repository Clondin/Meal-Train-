{
  "name": "meal-train",
  "version": "1.0.0",
  "description": "A platform for organizing meal delivery schedules for those in need",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "generate:types": "openapi-typescript backend/openapi.json -o frontend/src/types/api.generated.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "openapi-typescript": "^7.13.0"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@typescript-eslint/typescript-estree": "^8.56.1",
    "@typescript-eslint/type-utils": "^8.56.1",
    "@typescript-eslint/utils": "^8.56.1",
    "@typescript-eslint/scope-manager": "^8.56.1",
    "@typescript-eslint/visitor-keys": "^8.56.1",
    "@typescript-eslint/types": "^8.56.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
