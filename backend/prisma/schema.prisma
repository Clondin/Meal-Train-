generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH MODELS
// ============================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String?
  firstName         String?
  lastName          String?
  phone             String?
  avatar            String?
  emailVerified     Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  timezone          String    @default("America/New_York")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // OAuth connections
  oauthProviders    OAuthProvider[]

  // Relations
  organizedTrains   MealTrain[]     @relation("Organizer")
  adminTrains       TrainAdmin[]
  participants      Participant[]
  contributions     Contribution[]
  donations         Donation[]
  giftCards         GiftCard[]
  sessions          Session[]
  notifications     Notification[]
  simchaContributions SimchaContribution[]
  thankYouNotes     ThankYouNote[]

  @@map("users")
}

model OAuthProvider {
  id         String   @id @default(uuid())
  provider   String   // google, facebook
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@map("oauth_providers")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("sessions")
}

// Guest session for low-friction signup
model GuestSession {
  id               String   @id @default(uuid())
  identifier       String   // Phone or email
  identifierType   String   // 'phone' or 'email'
  verificationCode String?
  verified         Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@unique([identifier, identifierType])
  @@map("guest_sessions")
}

// ============================================
// CHESED TRAIN (MAIN MODEL)
// ============================================

model MealTrain {
  id                  String            @id @default(uuid())
  slug                String            @unique
  title               String
  description         String?
  story               String?           // Recipient's story
  coverImage          String?

  // Recipient info
  recipientName       String
  recipientEmail      String?
  recipientPhone      String?
  recipientAddress    String?
  recipientCity       String?
  recipientState      String?
  recipientZip        String?
  recipientCountry    String            @default("USA")

  // Basic Preferences (legacy support)
  dietaryPreferences  String?
  allergies           String?
  foodLikes           String?
  foodDislikes        String?
  deliveryInstructions String?
  householdSize       Int               @default(1)

  // ===== NEW: Enhanced Kosher/Dietary Settings =====
  requireMilchigFleishig Boolean        @default(true)   // Require category selection
  acceptsMilchig         Boolean        @default(true)
  acceptsFleishig        Boolean        @default(true)
  acceptsPareve          Boolean        @default(true)
  
  // Kashrus requirements
  requireCholovYisroel   Boolean        @default(false)
  requirePasYisroel      Boolean        @default(false)
  requireYoshon          Boolean        @default(false)
  requireGlatt           Boolean        @default(true)
  
  // Structured allergies
  allergyNuts            Boolean        @default(false)
  allergyDairy           Boolean        @default(false)
  allergyGluten          Boolean        @default(false)
  allergyEggs            Boolean        @default(false)
  allergyFish            Boolean        @default(false)
  allergyShellfish       Boolean        @default(false)
  allergySoy             Boolean        @default(false)
  allergyOther           String?

  // Schedule
  startDate           DateTime
  endDate             DateTime
  defaultDeliveryTime String            @default("18:00")
  timezone            String            @default("America/New_York")

  // Settings
  isPublic            Boolean           @default(false)
  allowDonations      Boolean           @default(true)
  allowGiftCards      Boolean           @default(true)
  donationGoal        Decimal?          @db.Decimal(10, 2)
  requireApproval     Boolean           @default(false)
  showParticipantList Boolean           @default(true)
  enableReminders     Boolean           @default(true)
  reminderHours       Int               @default(24)
  
  // ===== NEW: Allow non-meal tasks =====
  allowNonMealTasks   Boolean           @default(false)

  // Type and status
  trainType           TrainType         @default(STANDARD)
  status              TrainStatus       @default(ACTIVE)
  category            TrainCategory     @default(OTHER)

  // Organization/Organizer
  organizerId         String
  organizer           User              @relation("Organizer", fields: [organizerId], references: [id])

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relations
  admins              TrainAdmin[]
  dates               MealDate[]
  participants        Participant[]
  taskSlots           TaskSlot[]
  contributions       Contribution[]
  donations           Donation[]
  giftCards           GiftCard[]
  notifications       Notification[]
  simchaContributions SimchaContribution[]
  thankYouNotes       ThankYouNote[]

  @@index([slug])
  @@index([organizerId])
  @@map("chesed_trains")
}

enum TrainType {
  STANDARD        // Regular chesed train (meals primarily)
  POTLUCK         // Multiple participants per date
  FULL_CHESED     // Meals + non-meal tasks (babysitting, rides, etc.)
  SIMCHA          // Simcha/Kiddush contribution mode
  EVENT           // One-time event coordination
}

enum TrainStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TrainCategory {
  NEW_BABY
  ILLNESS
  SURGERY
  LOSS
  INJURY
  SHIVA
  SIMCHA
  KIDDUSH
  COMMUNITY_EVENT
  OTHER
}

model TrainAdmin {
  id          String      @id @default(uuid())
  trainId     String
  train       MealTrain @relation(fields: [trainId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        AdminRole   @default(ADMIN)
  createdAt   DateTime    @default(now())

  @@unique([trainId, userId])
  @@map("train_admins")
}

enum AdminRole {
  ADMIN
  MODERATOR
}

// ============================================
// MEAL DATES & PARTICIPANTS (LEGACY SCHEDULING)
// ============================================

model MealDate {
  id              String      @id @default(uuid())
  trainId         String
  train           MealTrain   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  date            DateTime    @db.Date
  deliveryTime    String
  maxParticipants Int         @default(1)
  notes           String?
  status          DateStatus  @default(AVAILABLE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  participants    Participant[]

  @@unique([trainId, date])
  @@index([trainId])
  @@map("meal_dates")
}

enum DateStatus {
  AVAILABLE
  FILLED
  CLOSED
  CANCELLED
}

model Participant {
  id              String             @id @default(uuid())
  trainId         String
  train           MealTrain          @relation(fields: [trainId], references: [id], onDelete: Cascade)
  dateId          String
  date            MealDate           @relation(fields: [dateId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  mealDescription String?
  notes           String?
  status          ParticipantStatus  @default(CONFIRMED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([trainId])
  @@index([dateId])
  @@index([userId])
  @@map("participants")
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

// ============================================
// TASK SLOT (Replaces MealDate - more flexible)
// ============================================

model TaskSlot {
  id              String          @id @default(uuid())
  trainId         String
  train           MealTrain     @relation(fields: [trainId], references: [id], onDelete: Cascade)
  
  date            DateTime        @db.Date
  startTime       String?         // Optional time window (HH:mm)
  endTime         String?         // Optional time window (HH:mm)
  
  taskType        TaskType        @default(MEAL_DINNER)
  
  // Split-meal support
  allowSplit      Boolean         @default(false)  // Allow multiple contributors for components
  maxContributors Int             @default(1)
  
  // For non-meal tasks
  taskTitle       String?         // Custom title for non-meal tasks
  taskDescription String?
  estimatedDuration Int?          // Minutes
  location        String?         // For rides, hospital visits
  
  notes           String?
  status          SlotStatus      @default(AVAILABLE)
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  contributions   Contribution[]
  
  @@unique([trainId, date, taskType])
  @@index([trainId, date])
  @@map("task_slots")
}

// ===== NEW: Comprehensive Task Types =====
enum TaskType {
  // Meal types
  MEAL_BREAKFAST
  MEAL_LUNCH
  MEAL_DINNER
  
  // Shabbos-specific
  MEAL_SHABBOS_FRIDAY_NIGHT
  MEAL_SHABBOS_DAY
  MEAL_SEUDAH_SHLISHIS
  
  // Non-meal chesed
  BABYSITTING
  HOSPITAL_VISIT
  RIDES
  GROCERY_RUN
  ERRANDS
  LAUNDRY
  HOUSEHOLD_HELP
  DOG_WALKING
  CHILDCARE_PICKUP
  OTHER_TASK
}

enum SlotStatus {
  AVAILABLE
  PARTIALLY_FILLED
  FILLED
  CLOSED
  CANCELLED
}

// ============================================
// CONTRIBUTION (Enhanced Participant Model)
// ============================================

model Contribution {
  id              String              @id @default(uuid())
  slotId          String
  slot            TaskSlot            @relation(fields: [slotId], references: [id], onDelete: Cascade)
  trainId         String
  train           MealTrain         @relation(fields: [trainId], references: [id], onDelete: Cascade)
  
  // Contributor (user or guest)
  userId          String?
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Guest info (if not registered user)
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  guestVerified   Boolean             @default(false)
  verificationCode String?
  
  // ===== Meal-specific details =====
  mealComponent   MealComponent       @default(FULL_MEAL)
  mealCategory    MealCategory?       // Milchig/Fleishig/Pareve
  
  // Kashrus certifications (multiple allowed)
  isCholovYisroel Boolean             @default(false)
  isPasYisroel    Boolean             @default(false)
  isYoshon        Boolean             @default(false)
  isGlatt         Boolean             @default(true)
  
  allergyInfo     String?             // Any allergy info about the food
  
  // ===== Day-of confirmation =====
  confirmedMealCategory Boolean       @default(false)
  confirmedAt     DateTime?
  dayOfReminderSent Boolean           @default(false)
  dayOfReminderSentAt DateTime?
  
  // ===== Delivery tracking =====
  deliveryStatus  DeliveryStatus      @default(NOT_STARTED)
  deliveryStatusUpdatedAt DateTime?
  estimatedArrival DateTime?
  
  // Description & notes
  itemDescription String?             // What they're bringing / doing
  notes           String?             // Additional notes
  
  // Status tracking
  status          ContributionStatus  @default(CONFIRMED)
  reminderSent    Boolean             @default(false)
  reminderSentAt  DateTime?
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  thankYouNotes   ThankYouNote[]
  
  @@index([slotId])
  @@index([trainId])
  @@index([userId])
  @@map("contributions")
}

// ===== NEW: Meal Component for split meals =====
enum MealComponent {
  FULL_MEAL
  PROTEIN_MAIN
  SIDES
  SALAD
  SOUP
  DESSERT
  DRINKS
  BREAD_CHALLAH
  APPETIZER
  KUGEL
  OTHER
}

// ===== NEW: Kosher Category =====
enum MealCategory {
  MILCHIG
  FLEISHIG
  PAREVE
}

// ===== NEW: Delivery Status Tracking =====
enum DeliveryStatus {
  NOT_STARTED
  PREPARING
  LEAVING_NOW
  EN_ROUTE
  ARRIVING_SOON
  DELIVERED
}

enum ContributionStatus {
  PENDING       // Awaiting approval
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ============================================
// SIMCHA CONTRIBUTION (For event/kiddush mode)
// ============================================

model SimchaContribution {
  id              String        @id @default(uuid())
  trainId         String
  train           MealTrain   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  
  // Contributor
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName       String?
  guestPhone      String?
  guestEmail      String?
  
  // What they're bringing
  itemCategory    SimchaItemCategory
  itemDescription String
  servings        Int?          // Approximate number of servings
  quantity        String?       // e.g., "2 trays", "1 platter"
  
  // Dietary info
  mealCategory    MealCategory?
  isCholovYisroel Boolean       @default(false)
  isPasYisroel    Boolean       @default(false)
  isYoshon        Boolean       @default(false)
  isGlatt         Boolean       @default(true)
  
  notes           String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([trainId])
  @@map("simcha_contributions")
}

enum SimchaItemCategory {
  APPETIZER
  MAIN_DISH
  SIDE_DISH
  SALAD
  SOUP
  KUGEL
  CHALLAH_BREAD
  DESSERT
  DRINKS
  SNACKS
  PAPER_GOODS
  OTHER
}

// ============================================
// DONATIONS & GIFT CARDS
// ============================================

model Donation {
  id              String        @id @default(uuid())
  trainId         String
  train           MealTrain   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Donor info
  donorName       String
  donorEmail      String
  isAnonymous     Boolean       @default(false)

  // Payment
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  stripePaymentId String?
  status          PaymentStatus @default(PENDING)

  // Message
  message         String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([trainId])
  @@map("donations")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model GiftCard {
  id              String        @id @default(uuid())
  trainId         String
  train           MealTrain   @relation(fields: [trainId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Purchaser info
  purchaserName   String
  purchaserEmail  String

  // Gift card details
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  vendor          String        // e.g., "DoorDash", "UberEats", "GrubHub"
  code            String?
  message         String?

  // Payment
  stripePaymentId String?
  status          PaymentStatus @default(PENDING)

  // Delivery
  deliveredAt     DateTime?
  deliveryEmail   String?       // Email to send gift card to

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([trainId])
  @@map("gift_cards")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String            @id @default(uuid())
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainId     String?
  train       MealTrain?      @relation(fields: [trainId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String
  data        Json?             // Additional data

  email       String?           // For non-user notifications
  phone       String?           // For SMS notifications
  read        Boolean           @default(false)
  sent        Boolean           @default(false)
  sentAt      DateTime?

  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([trainId])
  @@map("notifications")
}

enum NotificationType {
  // Train lifecycle
  TRAIN_CREATED
  TRAIN_UPDATED
  TRAIN_COMPLETED
  
  // Contributions
  CONTRIBUTION_SIGNED_UP
  CONTRIBUTION_CANCELLED
  CONTRIBUTION_REMINDER
  
  // Day-of notifications
  DAY_OF_CONFIRMATION_REQUEST
  MILCHIG_FLEISHIG_CONFIRMED
  
  // Delivery tracking
  DELIVERY_STATUS_UPDATE
  DELIVERY_ARRIVING
  DELIVERY_COMPLETED
  
  // Donations
  DONATION_RECEIVED
  GIFT_CARD_RECEIVED
  
  // Simcha
  SIMCHA_CONTRIBUTION_ADDED
  
  // General
  REMINDER
  ADMIN_MESSAGE
}

model ThankYouNote {
  id              String       @id @default(uuid())
  trainId         String
  train           MealTrain    @relation(fields: [trainId], references: [id], onDelete: Cascade)
  contributionId  String?
  contribution    Contribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  recipientUserId String
  recipientUser   User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  message         String
  createdAt       DateTime     @default(now())

  @@index([trainId])
  @@index([contributionId])
  @@index([recipientUserId])
  @@map("thank_you_notes")
}
